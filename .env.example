# Copy to .env.local and fill in. Set the same values in Vercel project settings
# (Production, Preview, and Development).

# Production origin, no trailing slash. Drives every canonical URL, the sitemap,
# robots.txt, llms.txt, and Open Graph URLs. Without it the build falls back to
# https://das-consultancy-services.vercel.app.
NEXT_PUBLIC_SITE_URL=https://das-consultancy-services.vercel.app

# https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form enquiries are delivered.
CONTACT_TO_EMAIL=

# A sender on your Resend-verified domain (plain email address, not Gmail).
CONTACT_FROM_EMAIL=

# Search Console HTML-tag verification: paste only the content token, not the tag.
GOOGLE_SITE_VERIFICATION=
